{
  "name": "@engine/lens",
  "version": "0.1.0",
  "description": "The overlay layer: world-space spotlights, labeled arrows, the right-triangle distance overlay, and the in-house DOM masked spotlight — built strictly on public APIs so any private shortcut breaks visible features immediately.",
