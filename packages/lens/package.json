    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@engine/core": "workspace:*",
    "@engine/math": "workspace:*",
    "@engine/projection": "workspace:*",
    "@engine/renderer": "workspace:*",
    "@engine/tutorial": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
