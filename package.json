{
  "name": "engine-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run --project unit",
    "test:visual": "vitest run --project browser",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "perf": "node scripts/perf/tilemap-budget.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "dev:demo": "pnpm --filter bedrock-demo dev",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "catalog:",
    "playwright": "^1.62.1",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
